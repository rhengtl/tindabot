# Copy to frontend/.env.test.local (git-ignored) to enable the online integration suite
# (src/sync/__tests__/online.test.ts). Without that file the suite skips itself.
# It signs in to a REAL Supabase project as two dedicated test users. See docs/SETUP.md §7.

TINDABOT_TEST_USERS=1
TEST_SUPABASE_URL=https://<project-ref>.supabase.co
TEST_SUPABASE_ANON_KEY=<publishable-key>
# Both addresses must start with tindabot-test-; the suite refuses any other account.
TEST_USER_A_EMAIL=tindabot-test-a@example.com
TEST_USER_A_PASSWORD=<password-a>
TEST_USER_B_EMAIL=tindabot-test-b@example.com
TEST_USER_B_PASSWORD=<password-b>
