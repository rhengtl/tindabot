# Copy to frontend/.env.local (git-ignored). Every value here is optional:
# without this file the app builds and runs fully offline, with no sign-in.
# Setup guide: docs/SETUP.md

# --- Cloud backup (public values: they ship in the browser bundle; RLS protects the data) ---
# Project URL with no trailing slash and no path.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable / anon key. Never the service_role / secret key.
VITE_SUPABASE_ANON_KEY=<publishable-key>

# --- AI helper (server-only: used by `npm run dev` and by the host's serverless function) ---
# Never prefix these with VITE_, or they would be put into the browser bundle.
# GEMINI_API_KEY=<gemini-api-key>
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
