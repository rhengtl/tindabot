# Environment files: secrets and per-machine settings. Only the documented examples are tracked.
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and build output
node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.vite/
*.tsbuildinfo

# Test and tool output
coverage/
*.log

# Python (tools/ reference model)
__pycache__/
*.py[co]

# Supabase CLI local state (created by `supabase link`)
supabase/.temp/
supabase/.branches/

# Vercel CLI project link
.vercel/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
